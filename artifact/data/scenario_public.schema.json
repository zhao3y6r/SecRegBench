{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecRegBench public scenario record v0.14",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_id",
    "decision_date",
    "dialogue",
    "dialogue_sha256",
    "family_id",
    "label",
    "leakage_component_id",
    "relation_spec",
    "scenario_id",
    "schema_version",
    "split",
    "split_protocol_version",
    "state",
    "suite"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^SRB27-"
    },
    "family_id": {
      "type": "string",
      "pattern": "^SRB27-"
    },
    "component_id": {
      "type": "string"
    },
    "leakage_component_id": {
      "type": "string",
      "pattern": "^COMP-"
    },
    "suite": {
      "enum": [
        "benign_hard_negative",
        "compositional_ood",
        "counterfactual",
        "institution_role",
        "multi_turn",
        "temporal"
      ]
    },
    "split": {
      "enum": [
        "development",
        "heldout"
      ]
    },
    "split_protocol_version": {
      "type": "string"
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "dialogue_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dialogue": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "text"
        ],
        "properties": {
          "role": {
            "enum": [
              "customer",
              "assistant"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "jurisdiction",
        "institution",
        "assistant",
        "customer",
        "suitability",
        "product",
        "request",
        "interaction",
        "data",
        "market_integrity",
        "evidence"
      ],
      "properties": {
        "jurisdiction": {
          "type": "object"
        },
        "institution": {
          "type": "object"
        },
        "assistant": {
          "type": "object"
        },
        "customer": {
          "type": "object"
        },
        "suitability": {
          "type": "object"
        },
        "product": {
          "type": "object"
        },
        "request": {
          "type": "object"
        },
        "interaction": {
          "type": "object"
        },
        "data": {
          "type": "object"
        },
        "market_integrity": {
          "type": "object"
        },
        "evidence": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "required": [
        "primary_action",
        "acceptable_actions",
        "severity",
        "controlling_rule_ids"
      ],
      "properties": {
        "primary_action": {
          "enum": [
            "ANSWER",
            "CLARIFY",
            "REFUSE",
            "ESCALATE"
          ]
        },
        "acceptable_actions": {
          "type": "array",
          "items": {
            "enum": [
              "ANSWER",
              "CLARIFY",
              "REFUSE",
              "ESCALATE"
            ]
          }
        },
        "severity": {
          "type": "string"
        },
        "controlling_rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "relation_spec": {
      "type": "object"
    }
  }
}
